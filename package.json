{
  "name": "stockwisepro-bot",
  "version": "1.0.0",
  "description": "Telegram bot for StockWisePro (AlphaSpectrum) - experimental analytics & scoring study",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test/smoke.js && node test/learning.test.js && node test/e2e.test.js",
    "test:smoke": "node test/smoke.js",
    "test:learning": "node test/learning.test.js",
    "test:e2e": "npm run build && node test/e2e.test.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "docker:build": "docker build -t stockwisepro-bot .",
    "docker:run": "docker run --env-file .env -v $(pwd)/data:/app/data stockwisepro-bot"
  },
  "keywords": [
    "telegram",
    "bot",
    "stock",
    "alphaspectrum",
    "stockwisepro"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
