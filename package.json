{
  "name": "stockwisepro-bot",
  "version": "1.0.0",
  "description": "Telegram bot for StockWisePro (AlphaSpectrum) - experimental analytics & scoring study",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test/smoke.js && node test/ocr.test.js && node test/learning.test.js && node test/e2e.test.js",
    "test:smoke": "node test/smoke.js",
    "test:learning": "node test/learning.test.js",
    "test:e2e": "npm run build && node test/e2e.test.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "docker:build": "docker build -t stockwisepro-bot .",
    "docker:run": "docker run --env-file .env -v $(pwd)/data:/app/data stockwisepro-bot"
  },
  "keywords": [
    "telegram",
    "bot",
    "stock",
    "alphaspectrum",
    "stockwisepro"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@upstash/redis": "^1.37.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "cheerio": "^1.2.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.5.0",
    "telegraf": "^4.16.3",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.0",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
