# Telegram (production bot — do NOT run local dev with this same token or you'll get 409 conflicts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Optional: separate dev/test bot token for local development (create via @BotFather)
# TELEGRAM_BOT_TOKEN_DEV=your_dev_bot_token_from_botfather

# StockWisePro API
STOCKWISE_API_BASE_URL=https://stockwise-pro-api.onrender.com
STOCKWISE_API_KEY=optional_if_api_requires_header

# Brave Search API (https://api.search.brave.com)
BRAVE_API_KEY=BSACnkPWO1lSSZ7w3gHeg_esdr6sj8l

# Bot Config
BOT_ADMIN_TELEGRAM_IDS=123456789,987654321
DATA_DIR=./data

# Alerts
ALERT_CHECK_INTERVAL_MINUTES=5

# Health check server port
HEALTH_PORT=3000

# Optional: Link to StockWisePro accounts
STOCKWISE_BOT_USER_EMAIL=bot@stockwisepro.local
STOCKWISE_BOT_USER_PASSWORD=changeme

# Optional: Databento live market data (https://databento.com)
DATABENTO_API_KEY=db-xxxxxxxxxxxxxxxx

# Optional: Redis cache (Upstash, Redis Cloud, or local)
REDIS_URL=redis://localhost:6379

# Optional: Upstash Redis REST (preferred for Render/serverless)
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: Alpaca Markets API (https://alpaca.markets)
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_PAPER=true

# Optional: Financial Modeling Prep API (https://financialmodelingprep.com)
FMP_API_KEY=your-fmp-api-key
